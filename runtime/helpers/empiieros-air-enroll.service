[Unit]
Description=EmpiierOS Air enroll WSS helper
Documentation=file:///opt/empiieros/docs/RUNTIME.md
RefuseManualStart=false
ConditionPathExists=/usr/local/sbin/empiieros-air-enroll
ConditionPathExists=/run/empiieros/air-enroll.request

[Service]
Type=oneshot
TimeoutStartSec=180
ExecStart=/usr/local/sbin/empiieros-air-enroll
User=root
Group=root
UMask=0077
Environment=EMPIIEROS_AIR_HELPER=1
Environment=EMPIIEROS_CAPSULE_SIGNING_PK=26b36dae25359712f8b328482a54f835c558c9bf708fb4a1d513ca7f165992d6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=tmpfs
ProtectSystem=strict
ReadWritePaths=/run/empiieros /var/lib/empiieros-runtime
# Prefer a hosts file without the portal VIP map so air still uses public A/AAAA.
BindReadOnlyPaths=-/run/empiieros/hosts-air:/etc/hosts
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

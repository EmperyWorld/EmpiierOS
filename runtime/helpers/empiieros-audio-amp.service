[Unit]
Description=EmpiierOS Dell ALC3204 speaker amp GPIO
Documentation=file:///opt/empiieros/docs/RUNTIME.md
After=sound.target
Wants=sound.target
ConditionPathExists=/usr/local/sbin/empiieros-audio-volume
ConditionPathExists=/dev/snd/hwC0D0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/empiieros-audio-volume --observe
User=root
Group=root
UMask=0077
SupplementaryGroups=audio
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
# Codec GPIO verbs need /dev/snd/hwC0D0. Do not set PrivateDevices=true.
DeviceAllow=/dev/snd/controlC0 rw
DeviceAllow=/dev/snd/hwC0D0 rw

[Install]
WantedBy=multi-user.target

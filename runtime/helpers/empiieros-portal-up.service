[Unit]
Description=EmpiierOS FoFline portal WireGuard bring-up
Documentation=file:///opt/empiieros/docs/RUNTIME.md
RefuseManualStart=false
ConditionPathExists=/usr/local/sbin/empiieros-portal-up
ConditionPathExists=/usr/local/sbin/empiieros-wg
ConditionPathExists=/run/empiieros/portal-up.request

[Service]
Type=oneshot
TimeoutStartSec=45
ExecStart=/usr/local/sbin/empiieros-portal-up
User=root
Group=root
UMask=0077
Environment=EMPIIEROS_PORTAL_HELPER=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=tmpfs
ProtectSystem=strict
ReadWritePaths=/run/empiieros /var/lib/empiieros-runtime /etc/hosts
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
